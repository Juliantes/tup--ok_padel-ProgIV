<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ok Padel" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ok Padel">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom mb-4">
      <div class="container">
        <%= link_to "Ok Padel", root_path, class: "navbar-brand fw-bold" %>
        <div class="d-flex align-items-center gap-2">
          <% if user_signed_in? %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "btn btn-outline-dark btn-sm" %>
            <% end %>
            <span class="small text-muted"><%= current_user.name %></span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-outline-secondary btn-sm" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container pb-4">
      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
