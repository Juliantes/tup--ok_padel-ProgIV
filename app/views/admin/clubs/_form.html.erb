<%= form_with model: [:admin, club], html: { class: "row g-3" } do |f| %>
  <% if club.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% club.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true, maxlength: 255 %>
  </div>

  <div class="col-md-6">
    <%= f.label :owner_id, "Owner", class: "form-label" %>
    <%= f.collection_select :owner_id,
      User.includes(:user_roles).order(:name),
      :id,
      :name,
      { prompt: "Select an owner" },
      class: "form-select",
      required: true %>
  </div>

  <div class="col-12">
    <%= f.label :address, class: "form-label" %>
    <%= f.text_field :address, class: "form-control", required: true, maxlength: 255 %>
  </div>

  <div class="col-md-6">
    <%= f.label :phone, class: "form-label" %>
    <%= f.telephone_field :phone, class: "form-control", required: true, maxlength: 255 %>
  </div>

  <div class="col-md-6">
    <%= f.label :email, class: "form-label" %>
    <%= f.email_field :email, class: "form-control", maxlength: 255 %>
  </div>

  <div class="col-12">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_clubs_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
