<% content_for :title, "Clubs - Admin" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Clubs</h1>
  <%= link_to "New club", new_admin_club_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Owner</th>
          <th>Phone</th>
          <th>Email</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @clubs.each do |club| %>
          <tr>
            <td><%= club.name %></td>
            <td><%= club.owner.name %></td>
            <td><%= club.phone %></td>
            <td><%= club.email.presence || "—" %></td>
            <td class="text-end">
              <%= link_to "View", admin_club_path(club), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Edit", edit_admin_club_path(club), class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%== @pagy.bootstrap_series_nav if @pagy.pages > 1 %>
