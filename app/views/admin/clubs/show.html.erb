<% content_for :title, "#{@club.name} - Admin" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><%= @club.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_admin_club_path(@club), class: "btn btn-primary" %>
    <%= button_to "Delete", admin_club_path(@club), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Owner</dt>
      <dd class="col-sm-9"><%= @club.owner.name %></dd>
      <dt class="col-sm-3">Address</dt>
      <dd class="col-sm-9"><%= @club.address %></dd>
      <dt class="col-sm-3">Phone</dt>
      <dd class="col-sm-9"><%= @club.phone %></dd>
      <dt class="col-sm-3">Email</dt>
      <dd class="col-sm-9"><%= @club.email.presence || "—" %></dd>
      <dt class="col-sm-3">Courts</dt>
      <dd class="col-sm-9"><%= @club.courts.count %></dd>
    </dl>
  </div>
</div>

<%= link_to "Back to clubs", admin_clubs_path, class: "btn btn-link mt-3" %>
