<%= form_with model: [:admin, court], html: { class: "row g-3" } do |f| %>
  <% if court.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% court.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :club_id, class: "form-label" %>
    <%= f.collection_select :club_id, Club.order(:name), :id, :name, { prompt: "Select a club" }, class: "form-select" %>
  </div>

  <div class="col-md-6">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", maxlength: 255 %>
  </div>

  <div class="col-md-4">
    <%= f.label :court_type, class: "form-label" %>
    <%= f.select :court_type, Court.court_types.keys, {}, class: "form-select" %>
  </div>

  <div class="col-md-4">
    <%= f.label :price_per_hour, class: "form-label" %>
    <%= f.number_field :price_per_hour, step: 0.01, min: 0.01, max: Court::MAX_PRICE_PER_HOUR, class: "form-control" %>
  </div>

  <div class="col-md-4">
    <%= f.label :status, class: "form-label" %>
    <%= f.select :status, Court.statuses.keys, {}, class: "form-select" %>
  </div>

  <div class="col-12">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 3, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :image, class: "form-label" %>
    <%= f.file_field :image, class: "form-control", accept: "image/png,image/jpeg,image/webp" %>
  </div>

  <div class="col-12">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_courts_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
