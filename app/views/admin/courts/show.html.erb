<% content_for :title, "#{@court.name} - Admin" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><%= @court.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_admin_court_path(@court), class: "btn btn-primary" %>
    <%= button_to "Delete", admin_court_path(@court), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Club</dt>
      <dd class="col-sm-9"><%= @court.club.name %></dd>
      <dt class="col-sm-3">Type</dt>
      <dd class="col-sm-9"><%= @court.court_type %></dd>
      <dt class="col-sm-3">Price per hour</dt>
      <dd class="col-sm-9">$<%= @court.price_per_hour %></dd>
      <dt class="col-sm-3">Status</dt>
      <dd class="col-sm-9"><span class="badge text-bg-secondary"><%= @court.status %></span></dd>
      <dt class="col-sm-3">Description</dt>
      <dd class="col-sm-9"><%= @court.description.presence || "—" %></dd>
    </dl>
  </div>
</div>

<div class="card border-primary">
  <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
      <h2 class="h5 mb-1">Time slots</h2>
      <p class="text-muted mb-0">
        Weekly availability for this court
        (<%= @court.time_slots.size %> configured).
      </p>
    </div>
    <%= link_to "Manage time slots",
                admin_court_time_slots_path(@court),
                class: "btn btn-primary flex-shrink-0" %>
  </div>
</div>

<%= link_to "Back to courts", admin_courts_path, class: "btn btn-link mt-3 px-0" %>
