<% content_for :title, "Edit result - Admin" %>

<h1 class="h3 mb-4">Edit result</h1>

<div class="card mb-4">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Match</dt>
      <dd class="col-sm-9"><%= @match.court.name %> — <%= @match.date.strftime("%d/%m/%Y %H:%M") %></dd>
      <dt class="col-sm-3">Reporter</dt>
      <dd class="col-sm-9"><%= @match_result.reported_by.name %></dd>
      <% if @match_result.forced_by_admin? %>
        <dt class="col-sm-3">Source</dt>
        <dd class="col-sm-9"><span class="badge text-bg-danger">Forced by admin</span></dd>
      <% end %>
    </dl>
  </div>
</div>

<%= form_with model: [:admin, @match, @match_result], html: { class: "row g-3" } do |f| %>
  <% if @match_result.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @match_result.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-12">
    <%= f.fields_for :match_sets do |set_form| %>
      <div class="row g-2 align-items-end mb-2">
        <div class="col-md-2">
          <%= set_form.label :order, "Set #{set_form.object.order}", class: "form-label" %>
          <%= set_form.hidden_field :order %>
          <%= set_form.hidden_field :id if set_form.object.persisted? %>
        </div>
        <div class="col-md-4">
          <%= set_form.label :team_a_games, "Team A", class: "form-label" %>
          <%= set_form.number_field :team_a_games, min: 0, max: 99, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= set_form.label :team_b_games, "Team B", class: "form-label" %>
          <%= set_form.number_field :team_b_games, min: 0, max: 99, class: "form-control" %>
        </div>
        <% if set_form.object.persisted? %>
          <div class="col-md-2">
            <%= set_form.check_box :_destroy, class: "form-check-input" %>
            <%= set_form.label :_destroy, "Remove", class: "form-check-label" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="col-12">
    <%= f.submit "Save changes", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_match_path(@match), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
