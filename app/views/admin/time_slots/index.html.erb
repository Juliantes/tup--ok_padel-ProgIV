<% content_for :title, "Time Slots - #{@court.name} - Admin" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Time Slots — <%= @court.name %></h1>
  <%= link_to "New time slot", new_admin_court_time_slot_path(@court), class: "btn btn-primary" %>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>Day</th>
          <th>Start</th>
          <th>End</th>
          <th>Available</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @time_slots.each do |time_slot| %>
          <tr>
            <td><%= time_slot.day_name %></td>
            <td><%= time_slot.start_time.strftime("%H:%M") %></td>
            <td><%= time_slot.end_time.strftime("%H:%M") %></td>
            <td>
              <% if time_slot.is_available? %>
                <span class="badge text-bg-success">Yes</span>
              <% else %>
                <span class="badge text-bg-secondary">No</span>
              <% end %>
            </td>
            <td class="text-end">
              <%= link_to "View", admin_time_slot_path(time_slot), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Edit", edit_admin_time_slot_path(time_slot), class: "btn btn-sm btn-outline-primary" %>
              <%= button_to "Delete", admin_time_slot_path(time_slot), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>

<%= link_to "Back to court", admin_court_path(@court), class: "btn btn-link mt-3" %>
