<% content_for :title, "Matches - Admin" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Matches</h1>
  <%= form_with url: admin_matches_path, method: :get, class: "d-flex gap-2" do %>
    <%= select_tag :status, options_for_select(Match.statuses.keys.map { |s| [s.humanize, s] }, params[:status]), include_blank: "All statuses", class: "form-select" %>
    <%= submit_tag "Filter", class: "btn btn-outline-secondary" %>
  <% end %>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>Court</th>
          <th>Creator</th>
          <th>Date</th>
          <th>Duration</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @matches.each do |match| %>
          <tr>
            <td><%= match.court.name %></td>
            <td><%= match.creator.name %></td>
            <td><%= match.date.strftime("%d/%m/%Y %H:%M") %></td>
            <td><%= match.duration %> min</td>
            <td><span class="badge text-bg-secondary"><%= match.status %></span></td>
            <td class="text-end">
              <%= link_to "View", admin_match_path(match), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Edit", edit_admin_match_path(match), class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
