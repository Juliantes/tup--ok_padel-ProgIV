<% content_for :title, "Match - Admin" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Match details</h1>
  <%= link_to "Edit", edit_admin_match_path(@match), class: "btn btn-primary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Court</dt>
      <dd class="col-sm-9"><%= @match.court.name %></dd>
      <dt class="col-sm-3">Creator</dt>
      <dd class="col-sm-9"><%= @match.creator.name %></dd>
      <dt class="col-sm-3">Date</dt>
      <dd class="col-sm-9"><%= @match.date.strftime("%d/%m/%Y %H:%M") %></dd>
      <dt class="col-sm-3">Duration</dt>
      <dd class="col-sm-9"><%= @match.duration %> minutes</dd>
      <dt class="col-sm-3">Status</dt>
      <dd class="col-sm-9"><span class="badge text-bg-secondary"><%= @match.status %></span></dd>
      <dt class="col-sm-3">Formato</dt>
      <dd class="col-sm-9"><%= roster_mode_label(@match.roster_mode) %></dd>
      <dt class="col-sm-3">Level required</dt>
      <dd class="col-sm-9"><%= category_label(@match[:level_required]) %></dd>
    </dl>
  </div>
</div>

<%= render "roster", return_to: "show" %>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="h5 mb-0">Results</h2>
    <% if @match.auto_approved_at.present? %>
      <span class="badge text-bg-warning">
        Auto-approved at <%= @match.auto_approved_at.strftime("%d/%m/%Y %H:%M") %>
      </span>
    <% end %>
    <% if @match.completed? %>
      <span class="badge text-bg-success">Completed</span>
    <% elsif @match.reported? %>
      <span class="badge text-bg-warning">In dispute</span>
    <% end %>
  </div>
  <div class="card-body">
    <% if @consensus %>
      <div class="alert alert-info">
        <strong>Consensus:</strong>
        <%= @consensus[:sets].sort_by(&:order).map { |s| "#{s.team_a_games}-#{s.team_b_games}" }.join(", ") %>
        (votes: <%= @consensus[:votes] %>/<%= @consensus[:total] %>)
      </div>
    <% elsif @match_results.any? %>
      <div class="alert alert-warning">No consensus yet.</div>
    <% else %>
      <p class="text-muted">No results reported.</p>
    <% end %>

    <% if @match_results.any? %>
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Reporter</th>
            <th>Sets</th>
            <th>Winner</th>
            <th>Forced</th>
            <th>Reported at</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @match_results.each do |result| %>
            <tr>
              <td><%= result.reported_by.name %></td>
              <td>
                <%= result.match_sets.sort_by(&:order).map { |s| "#{s.team_a_games}-#{s.team_b_games}" }.join(", ") %>
              </td>
              <td><%= result.winner_team.presence || "—" %></td>
              <td>
                <% if result.forced_by_admin? %>
                  <span class="badge text-bg-danger">Forced</span>
                <% end %>
              </td>
              <td><%= result.created_at.strftime("%d/%m/%Y %H:%M") %></td>
              <td class="text-end">
                <%= link_to "Edit", edit_admin_match_match_result_path(@match, result), class: "btn btn-sm btn-outline-primary" %>
                <%= button_to "Delete", admin_match_match_result_path(@match, result), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Delete this result?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

<% unless @match.completed? %>
  <div class="card mb-4">
    <div class="card-header">
      <h2 class="h5 mb-0">Force result</h2>
    </div>
    <div class="card-body">
      <%= form_with url: force_result_admin_match_path(@match), method: :post, class: "row g-3" do %>
        <% (1..5).each do |order| %>
          <div class="row g-2 mb-2 col-12">
            <div class="col-md-2">
              <label class="form-label">Set <%= order %></label>
            </div>
            <div class="col-md-4">
              <%= number_field_tag "force_result[sets][][team_a_games]", nil, placeholder: "Team A", min: 0, max: 99, class: "form-control" %>
            </div>
            <div class="col-md-4">
              <%= number_field_tag "force_result[sets][][team_b_games]", nil, placeholder: "Team B", min: 0, max: 99, class: "form-control" %>
            </div>
          </div>
        <% end %>
        <div class="col-12">
          <%= submit_tag "Force result", class: "btn btn-warning", data: { turbo_confirm: "Force result and close the match?" } %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mb-4">
    <%= button_to "Mark as played (no result)", mark_played_admin_match_path(@match), method: :post, class: "btn btn-outline-secondary", data: { turbo_confirm: "Mark as played without result?" } %>
  </div>
<% end %>

<%= link_to "Back to matches", admin_matches_path, class: "btn btn-link mt-3" %>
