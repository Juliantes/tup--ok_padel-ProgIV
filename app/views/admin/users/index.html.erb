<% content_for :title, "Users - Admin" %>

<h1 class="h3 mb-4">Users</h1>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Roles</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td><%= user.phone %></td>
            <td>
              <% user.user_roles.each do |user_role| %>
                <span class="badge text-bg-secondary me-1"><%= user_role.role %></span>
              <% end %>
            </td>
            <td class="text-end">
              <%= link_to "View", admin_user_path(user), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%== @pagy.bootstrap_series_nav if @pagy.pages > 1 %>
