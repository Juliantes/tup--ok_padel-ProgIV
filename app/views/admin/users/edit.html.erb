<% content_for :title, "Edit user - Admin" %>

<h1 class="h3 mb-4">Edit user</h1>

<%= form_with model: [:admin, @user], html: { class: "row g-3" } do |f| %>
  <% if @user.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :phone, class: "form-label" %>
    <%= f.text_field :phone, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :self_level, class: "form-label" %>
    <%= f.number_field :self_level, in: User::SELF_LEVEL_RANGE, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :bio, class: "form-label" %>
    <%= f.text_area :bio, rows: 3, class: "form-control" %>
  </div>

  <div class="col-12">
    <p class="form-label mb-2">Roles</p>
    <% User::ROLES.each do |role| %>
      <div class="form-check">
        <%= check_box_tag "user[role_#{role}]", "1", @user.has_role?(role), class: "form-check-input", id: "user_role_#{role}" %>
        <%= label_tag "user_role_#{role}", role.humanize, class: "form-check-label" %>
      </div>
    <% end %>
  </div>

  <div class="col-12">
    <%= f.submit "Save changes", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_user_path(@user), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
