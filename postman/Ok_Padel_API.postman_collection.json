  },
  "item": [
    {
      "name": "📁 Auth",
      "item": [
        {
          "name": "POST Login (happy)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response includes token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('token', json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"player@okpadel.local\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/login",
            "description": "Login con credenciales válidas (usuario demo del seed)."
          },
          "response": []
        },
        {
          "name": "POST Login (invalid credentials → 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
