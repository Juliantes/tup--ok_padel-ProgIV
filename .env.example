# Copy to .env (not committed) before docker compose up.
# RAILS_MASTER_KEY: paste contents of config/master.key (required in production image).
RAILS_MASTER_KEY=

# Used by POST /api/v1/oauth/google when the Angular app signs in with Firebase.
FIREBASE_PROJECT_ID=okpadel

# Optional: pass through to the frontend image build (see tup--padel-match- Dockerfile ARGs).
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID_FRONT=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
