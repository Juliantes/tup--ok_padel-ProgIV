# Copy to .env (not committed) before docker compose up.
# RAILS_MASTER_KEY: paste contents of config/master.key (required in production image).
RAILS_MASTER_KEY=

# API base URL baked into the Angular image (browser calls the host, not the container).
API_BASE_URL=http://localhost:3000

# Used by POST /api/v1/oauth/google (runtime, web/worker) and Angular build (frontend image).
# Same projectId as src/environments/environment.ts in tup--padel-match-.
FIREBASE_PROJECT_ID=okpadel

# Firebase Web SDK config (build-time only for the frontend Docker image).
# Copy from Firebase Console → Project settings → Your apps → Web, or from environment.ts.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
