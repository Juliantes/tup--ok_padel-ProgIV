        {
          "name": "POST Create match (auto_join: true)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Match created and matchId saved', function () {",
                  "    const match = pm.response.json().match;",
                  "    pm.expect(match).to.be.an('object');",
                  "    pm.expect(match.match_players.length).to.be.at.least(1);",
                  "    pm.environment.set('matchId', String(match.id));",
                  "});"
                ]
              }
            }
