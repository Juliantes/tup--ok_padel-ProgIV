{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "name": "Ok Padel API",
    "description": "Colección esqueleto para API v1 de Ok Padel. Importar junto con el environment **Ok Padel Local**. Ejecutar **Login** primero; los requests autenticados usan `Bearer {{token}}`. Tras `db:seed`, login de prueba: `player@okpadel.local` / `password123`. Ajustar bodies (p. ej. `court_id`, fechas) según tu base local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "📁 Auth",
      "item": [
        {
          "name": "POST Login (happy)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response includes token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('token', json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"player@okpadel.local\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/login",
            "description": "Login con credenciales válidas (usuario demo del seed)."
          },
          "response": []
        },
        {
          "name": "POST Login (invalid credentials → 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Error body present', function () {",
                  "    pm.expect(pm.response.json().error).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"player@okpadel.local\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/login",
            "description": "Credenciales incorrectas → 401 `{ \"error\": \"Invalid credentials\" }`."
          },
          "response": []
        }
      ]
    },
